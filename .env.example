
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="The Black Silk"
NODE_ENV="development"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database URL (Neon, Supabase, or local PostgreSQL)
# Note: If database connection fails, your Neon database may be hibernated
# Visit https://console.neon.tech to wake it up or use the direct endpoint
DATABASE_URL=

# Pooler connection (use for production with many connections)
# DATABASE_URL="postgresql://neondb_owner:npg_9NgBCAq1SUhD@ep-broad-voice-a815b2vk-pooler.eastus2.azure.neon.tech/neondb?sslmode=require&channel_binding=require"

# Alternative: Neon Database
# DATABASE_URL="postgresql://username:password@ep-example.us-east-1.aws.neon.tech/theblacksilk?sslmode=require"

# Alternative: Supabase Database
# DATABASE_URL="postgresql://postgres:password@db.project.supabase.co:5432/postgres"

# =============================================================================
# AUTHENTICATION (NextAuth.js)
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="DevBlackSilkSecret"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# LinkedIn OAuth (Optional)
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Settings for sending emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="noreply@theblacksilk.org"

# Alternative: SendGrid
# SENDGRID_API_KEY="SG.your-sendgrid-api-key"

# Alternative: Resend
# RESEND_API_KEY="re_your-resend-api-key"

# =============================================================================
# PAYMENT GATEWAY (Razorpay)
# =============================================================================
# NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your-key-id"
# RAZORPAY_KEY_ID="rzp_test_your-key-id"
# RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Alternative: Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# REAL-TIME FEATURES (Pusher)
# =============================================================================
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Alternative: Ably
# ABLY_API_KEY="your-ably-api-key"
# NEXT_PUBLIC_ABLY_KEY="your-ably-public-key"

# =============================================================================
# CONTENT MANAGEMENT (Hashnode Blog Integration)
# =============================================================================
HASHNODE_PUBLICATION_HOST=""
HASHNODE_API_TOKEN=""

# Alternative: Contentful
# CONTENTFUL_SPACE_ID="your-contentful-space-id"
# CONTENTFUL_ACCESS_TOKEN="your-contentful-access-token"

# =============================================================================
# FILE STORAGE (Vercel Blob)
# =============================================================================
BLOB_READ_WRITE_TOKEN=""

# Alternative: AWS S3
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="theblacksilk-uploads"

# Alternative: Cloudinary
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================
# Google Analytics
NEXT_PUBLIC_GA_ID="G-"

# Google Tag Manager (Optional)
NEXT_PUBLIC_GTM_ID=""

# Vercel Analytics (Automatically enabled on Vercel)
# No configuration needed

# PostHog (Optional)
# NEXT_PUBLIC_POSTHOG_KEY="phc_your-posthog-key"
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# =============================================================================
# SEARCH (Algolia - Optional)
# =============================================================================
NEXT_PUBLIC_ALGOLIA_APP_ID=""
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=""
ALGOLIA_ADMIN_API_KEY=""

# =============================================================================
# SOCIAL MEDIA INTEGRATION
# =============================================================================
# Twitter API (Optional)
TWITTER_API_KEY="your-twitter-api-key"
TWITTER_API_SECRET="your-twitter-api-secret"
TWITTER_ACCESS_TOKEN="your-twitter-access-token"
TWITTER_ACCESS_TOKEN_SECRET="your-twitter-access-token-secret"

# LinkedIn API (Optional)
LINKEDIN_API_KEY="your-linkedin-api-key"

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================
# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# CAPTCHA (hCaptcha or reCAPTCHA)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""

# =============================================================================
# AI INTEGRATION (Optional)
# =============================================================================
# OpenAI API
OPENAI_API_KEY="sk-your-openai-api-key"

# Anthropic Claude API
ANTHROPIC_API_KEY="your-anthropic-api-key"

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
# Enable debug logging
DEBUG="false"

# Disable telemetry
NEXT_TELEMETRY_DISABLED="1"

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# These will be different in production
# NEXT_PUBLIC_APP_URL="https://theblacksilk.org"
# NEXTAUTH_URL="https://theblacksilk.org"
# DATABASE_URL="your-production-database-url"
# NODE_ENV="production"

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================
# Slack Integration (for notifications)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/your/webhook/url"

# Discord Integration
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your/webhook/url"

# Zapier Integration
# ZAPIER_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/your/webhook/url"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
NEXT_PUBLIC_ENABLE_PAYMENTS="true"
NEXT_PUBLIC_ENABLE_MESSAGING="true"
NEXT_PUBLIC_ENABLE_FORUMS="false"
NEXT_PUBLIC_ENABLE_EVENTS="true"
NEXT_PUBLIC_ENABLE_COMMITTEES="true"

# =============================================================================
# LEGAL & COMPLIANCE
# =============================================================================
# Cookie consent
NEXT_PUBLIC_COOKIE_DOMAIN=".theblacksilk.org"

# Privacy policy and terms URLs
NEXT_PUBLIC_PRIVACY_POLICY_URL="/privacy"
NEXT_PUBLIC_TERMS_OF_SERVICE_URL="/terms"

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================
# Maintenance mode
NEXT_PUBLIC_MAINTENANCE_MODE="false"

# Backup configuration (if using automated backups)
# BACKUP_ENCRYPTION_KEY="your-backup-encryption-key"
