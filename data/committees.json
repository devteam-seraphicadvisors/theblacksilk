  "young-members": {
    "id": "young-members",
    "name": "Young Members Committee",
    "slug": "young-members",
    "description": "Empowering the next generation of legal professionals with technology skills and networking opportunities.",
    "fullDescription": "The Young Members Committee is dedicated to supporting early-career legal professionals in navigating the intersection of law and technology. We provide mentorship, networking opportunities, and skill development programs specifically designed for lawyers with 0-10 years of experience.\n\nOur mission is to bridge the gap between traditional legal education and the modern technology-driven legal landscape. Through workshops, mentorship programs, and networking events, we help young professionals build the skills they need to thrive in today's legal environment.\n\nWe focus on creating an inclusive community where young legal professionals can connect, learn, and grow together. Our programs are designed to address the unique challenges faced by early-career lawyers in today's rapidly evolving legal landscape.",
    "members": 4,
    "status": "Accepting Members",
    "chair": {
      "name": "Neil Dawes",
      "designation": "Chair, Young Members Committee",
      "email": "neil.dawes@theblacksilk.org",
      "linkedin": "https://linkedin.com/in/neildawes",
      "image": "/members/neil-dawes.png",
      "bio": "Neil is a technology lawyer with over 8 years of experience in legal tech innovation. He leads initiatives to bridge the gap between traditional legal practice and modern technology solutions."
    },
    "coChair": {
